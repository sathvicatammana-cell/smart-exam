# Hallpass Backend Environment Configuration
PORT=4000
NODE_ENV=development

# Firebase Project Configuration
FIREBASE_PROJECT_ID=smart-examination-dac73

# Firebase Admin Service Account Key
# Option A: Path to service account JSON file downloaded from Firebase Console
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccountKey.json

# Option B: Raw JSON string or Base64 string of service account key (Ideal for cloud hosting)
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"smart-examination-dac73",...}

# Frontend Origin for CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
